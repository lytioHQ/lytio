# ================================================================
# ExcelPilot Environment Configuration
# ================================================================
# Copy this file to docker/.env for Docker Compose
# Copy this file to backend/.env for FastAPI (or set in production env)
# ================================================================

# === PostgreSQL (Docker Compose) ===
POSTGRES_USER=excelpilot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=excelpilot
POSTGRES_PORT=5432

# === PostgreSQL (Application) ===
DATABASE_URL=postgresql+asyncpg://excelpilot:change-me@localhost:5432/excelpilot

# === DeepSeek API ===
DEEPSEEK_API_KEY=sk-your-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# === JWT ===
# IMPORTANT: In production, use a strong random secret (e.g. openssl rand -hex 32)
JWT_SECRET=change-me-to-a-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# === CORS ===
# In production, set to your frontend domain (e.g. https://app.excelpilot.com)
CORS_ORIGINS=http://localhost:3000

# === App ===
# APP_ENV: development | production
# APP_DEBUG: true (shows detailed errors) | false (user-friendly messages only)
APP_ENV=development
APP_DEBUG=true